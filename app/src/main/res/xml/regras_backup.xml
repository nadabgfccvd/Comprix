<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. O banco entra no backup do dispositivo; caches e backups
     gerados pelo proprio app ficam de fora (seriam duplicata). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="file" path="backups" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
