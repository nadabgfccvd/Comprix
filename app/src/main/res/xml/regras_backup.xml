<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. O banco entra no backup do dispositivo; todo o resto
     (caches, arquivos e backups gerados pelo proprio app) fica de fora
     porque só o dominio `database` está incluído — exclusões explícitas
     de domínios não incluídos são redundantes e o lint as sinaliza. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
